# 复制为 .env 后填写自己的配置，切勿提交真实凭证。
AI_DATABASE_URL=postgresql+psycopg://customer_service:replace-db-password@127.0.0.1:15432/ai_customer_service
API_HOST=127.0.0.1
API_PORT=8002
INTERNAL_SERVICE_TOKEN=replace-with-a-random-internal-token
JWT_SECRET=replace-with-a-random-secret-shared-with-ecommerce
JWT_ALGORITHM=HS256

# OpenRouter：使用支持工具调用的模型，填写自己账户可用的完整模型编号。
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=replace-with-your-openrouter-api-key
LLM_MODEL=z-ai/glm-5.3-flash
LLM_THINKING_MODE=disabled
LLM_TIMEOUT_SECONDS=30

ECOMMERCE_BASE_URL=http://127.0.0.1:8001/api/v1
ECOMMERCE_TIMEOUT_SECONDS=8
HISTORY_MESSAGE_LIMIT=30
HISTORY_CHARACTER_BUDGET=12000
PROMPT_VERSION=customer-support-v1

MULTI_AGENT_DELEGATION_LIMIT=6
MULTI_AGENT_PARALLEL_LIMIT=3
MULTI_AGENT_TASK_TOOL_LIMIT=8
MULTI_AGENT_TOTAL_TOOL_LIMIT=24
MULTI_AGENT_SUPERVISOR_MODEL_LIMIT=8
MULTI_AGENT_SPECIALIST_MODEL_LIMIT=10
MULTI_AGENT_TIMEOUT_SECONDS=120
